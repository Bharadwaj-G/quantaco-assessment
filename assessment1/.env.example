# --- Database (Cloud SQL for PostgreSQL) ---
DB_USER=weather_app
DB_PASS=changeme
DB_NAME=weather-db

# Local dev: run the Cloud SQL Auth Proxy, then leave these as-is
# (proxy listens on 127.0.0.1:5432 by default).
DB_HOST=127.0.0.1
DB_PORT=5432

# Cloud Run only: set this (via --add-cloudsql-instances) and leave
# DB_HOST/DB_PORT unset — database.py prefers the Unix socket when present.
# Format: /cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
# INSTANCE_UNIX_SOCKET=/cloudsql/my-project:us-central1:quantaco-weather-db

# Needed only for the local Cloud SQL Auth Proxy / apply_schema.py setup step,
# not read by the app itself.
# INSTANCE_CONNECTION_NAME=my-project:us-central1:quantaco-weather-db
